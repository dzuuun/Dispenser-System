NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ndmu_credentials
DB_USER=credentials_app
DB_PASSWORD=change_me
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
CREDENTIAL_ENCRYPTION_KEY=replace_with_64_hex_characters
KIOSK_CODE=KIOSK-MIS-01
KIOSK_SECRET=replace_with_a_kiosk_secret
INITIAL_SETUP_SECRET=replace_with_a_one_time_setup_secret
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_a_strong_password

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Dispenser trailing slash" stopProcessing="true">
          <match url="^dispenser$" />
          <action type="Redirect" url="/dispenser/" redirectType="Permanent" />
        </rule>
        <rule name="Dispenser proxy" stopProcessing="true">
          <match url="^dispenser/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/dispenser/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
